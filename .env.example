# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Model names (configurable: free-tier rosters change often)
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_MODEL=mistral-small-latest

# Optional: requests per minute we allow ourselves (keep below each free tier's limit)
# GEMINI_RPM=8
# GROQ_RPM=25
# MISTRAL_RPM=20

# Optional: paid-tier list prices (USD per 1M tokens) for the "equivalent cost".
# VERIFY on each provider's pricing page before reporting.
# GEMINI_PRICE_IN=0.30
# GEMINI_PRICE_OUT=2.50
# GROQ_PRICE_IN=0.15
# GROQ_PRICE_OUT=0.60
